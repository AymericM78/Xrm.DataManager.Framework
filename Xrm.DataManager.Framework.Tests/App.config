<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings configSource="Settings.config" />
  <!--
  Multiple environments : one entry per Dataverse instance, selected with Crm.Instance.Name setting,
  first command line argument or console prompt (Crm.ConnectionString setting is used when no entry is selected)
  <connectionStrings>
    <add name="Dev" connectionString="AuthType=ClientSecret;Url=https://dev.crm4.dynamics.com;ClientId=...;ClientSecret=..." />
    <add name="Uat" connectionString="AuthType=ClientSecret;Url=https://uat.crm4.dynamics.com;ClientId=...;ClientSecret=..." />
  </connectionStrings>
  -->
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!-- Binding redirects are generated at build time (AutoGenerateBindingRedirects) -->
</configuration>
