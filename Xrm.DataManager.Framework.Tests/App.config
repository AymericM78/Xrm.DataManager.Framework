<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Settings (git ignored) : Target.Connection.Name, Source.Connection.Name, Target.Job.Names, LogLevel... -->
  <appSettings configSource="Settings.config" />
  <!--
  Connections : one entry per Dataverse instance, target is selected with Target.Connection.Name setting,
  first command line argument or console prompt. "AppInsights" entry is reserved for Application Insights.
  <connectionStrings configSource="ConnectionStrings.config" />
  or :
  <connectionStrings>
    <add name="Dev" connectionString="AuthType=ClientSecret;Url=https://dev.crm4.dynamics.com;ClientId=...;ClientSecret=..." />
    <add name="Uat" connectionString="AuthType=ClientSecret;Url=https://uat.crm4.dynamics.com;ClientId=...;ClientSecret=..." />
    <add name="AppInsights" connectionString="InstrumentationKey=...;IngestionEndpoint=https://..." />
  </connectionStrings>
  -->
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!-- Binding redirects are generated at build time (AutoGenerateBindingRedirects) -->
</configuration>
