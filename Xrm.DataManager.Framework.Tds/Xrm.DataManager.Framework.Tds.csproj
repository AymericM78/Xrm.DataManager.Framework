<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RootNamespace>Xrm.DataManager.Framework</RootNamespace>
    <AssemblyName>Xrm.DataManager.Framework.Tds</AssemblyName>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Xrm.DataManager.Framework\Xrm.DataManager.Framework.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!-- NuGet package metadata (shared metadata in Directory.Build.props) -->
  <PropertyGroup>
    <PackageId>Xrm.DataManager.Framework.Tds</PackageId>
    <Title>Xrm.DataManager.Framework.Tds</Title>
    <Product>Xrm.DataManager.Framework</Product>
    <Description>Retrieve Dataverse records with SQL (TDS endpoint) for Xrm.DataManager.Framework</Description>
    <PackageTags>Dynamics 365 PowerApps CDS Dataverse TDS SQL</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Xrm.DataManager.Framework.UnitTests" Key="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.140.0" />
    <!-- Security fix : Microsoft.Data.SqlClient references a vulnerable version -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xrm.DataManager.Framework\Xrm.DataManager.Framework.csproj" />
  </ItemGroup>

</Project>
