<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RootNamespace>Xrm.DataManager.Framework</RootNamespace>
    <AssemblyName>Xrm.DataManager.Framework</AssemblyName>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Xrm.DataManager.Framework.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!-- NuGet package metadata (shared metadata in Directory.Build.props) -->
  <PropertyGroup>
    <PackageId>Xrm.DataManager.Framework</PackageId>
    <Title>Xrm.DataManager.Framework</Title>
    <Product>Xrm.DataManager.Framework</Product>
    <Description>Dynamics 365 / PowerApps CDS class library for Data Management</Description>
    <PackageTags>Dynamics 365 PowerApps CDS Dataverse</PackageTags>
  </PropertyGroup>

  <!-- Direct dependencies only: transitive packages are resolved by the consuming application -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.27" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Configuration" />
    <Reference Include="System.ServiceModel" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
    <!-- Security fixes : Dataverse.Client depends on System.ServiceModel 8.1.2 which references vulnerable versions -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
  </ItemGroup>

</Project>
